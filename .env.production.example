# ========================================
# Production Environment Variables Template
# 生產環境變數模板
# ========================================
# ⚠️ SECURITY WARNING: This is a TEMPLATE file
# ⚠️ 安全警告：這是一個模板檔案
#
# DO NOT commit actual credentials to git
# 不要將實際憑證提交到 git
#
# For Cloudflare Workers: Use wrangler secret put <KEY>
# For Vercel: Add these in project settings
# For GitHub Actions: Add as repository secrets
# ========================================

# Supabase (Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_POOLER_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Zeabur PostgreSQL (Business Data)
ZEABUR_POSTGRES_URL=postgresql://username:password@host:port/database

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Email Service
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# Company Settings
COMPANY_NAME=Your Company Name

# Application URLs
PORT=3333
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Security Keys (Generate with: openssl rand -base64 32)
CSRF_SECRET=your-random-32-char-csrf-secret
CRON_SECRET=your-random-cron-secret
ADMIN_API_KEY=your-admin-api-key

# Error Notifications (Optional)
ERROR_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SUCCESS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Node Environment
NODE_ENV=production
